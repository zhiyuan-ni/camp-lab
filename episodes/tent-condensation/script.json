  "title": "帐篷里为什么会“下雨”？",
  "subtitle": "结露原理与防治",
  "segments": [
    {
      "id": "s01",
      "scene": "intro",
      "narration": "清晨醒来，帐篷内壁挂满水珠，甚至滴到了睡袋上。是帐篷漏水了吗？",
      "props": { "hook": "是帐篷漏水了吗？" }
    },
    {
      "id": "s02",
      "scene": "title",
      "narration": "其实大多数时候，帐篷并没有漏水。这些水，来自帐篷里面的你。",
      "props": { "kicker": "真相", "heading": "结露，不是漏水", "sub": "水来自帐篷里面" }
    },
    {
      "id": "s03",
      "scene": "stat",
      "narration": "一个成年人睡一晚，通过呼吸和皮肤散发的水汽，大约有半升到一升。",
      "props": { "value": "0.5~1", "unit": "升", "label": "一个人一晚通过呼吸和皮肤散发的水汽", "note": "相当于一到两瓶矿泉水" }
    },
    {
      "id": "s04",
      "scene": "diagram",
      "narration": "这些水汽让帐篷里的空气又暖又湿。暖湿空气上升，碰到被夜风吹冷的外帐。当布料温度低于空气的露点，水汽就会在内侧凝结成水珠。",
      "props": {
        "diagram": "condensation",
        "heading": "结露是怎么发生的",
        "steps": ["人体散发水汽，帐内又暖又湿", "暖湿空气上升，接触冰冷外帐", "低于露点，水汽凝结成水珠"]
      }
    },
    {
      "id": "s05",
      "scene": "diagram",
      "narration": "所谓露点，就是空气中的水汽开始凝结的温度。空气越湿，露点越高，也就越容易结露。",
      "props": {
        "diagram": "flow",
        "heading": "关键概念：露点",
        "steps": ["暖湿空气", "遇到冷表面", "降到露点以下", "凝结成水"]
      }
    },
    {
      "id": "s06",
      "scene": "comparison",
      "narration": "无风、潮湿的夜晚，在水边低洼处扎营，又把门窗全部关紧，最容易结露。有微风、地势略高、通风口打开时，结露就会少很多。",
      "props": {
        "heading": "什么时候最容易结露？",
        "left": { "label": "容易结露", "tone": "bad", "points": ["无风、潮湿的夜晚", "河边、湖边低洼处", "门窗全部紧闭"] },
        "right": { "label": "不易结露", "tone": "good", "points": ["有微风的干燥夜晚", "地势略高的开阔处", "打开通风口"] }
      }
    },
    {
      "id": "s07",
      "scene": "checklist",
      "narration": "记住这份防结露清单：打开顶部通风口，让内外帐保持张紧不贴合，避开河边洼地，湿衣物不要放进内帐，早上先擦干再收帐。",
      "props": {
        "heading": "防结露清单",
